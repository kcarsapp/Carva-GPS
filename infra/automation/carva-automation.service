[Unit]
Description=Carva Fleet geofence automation (alerts + fuel-cut rules)
Documentation=file:/opt/carva/automation/README.md
# Traccar must be up before we try to authenticate. We still tolerate it being
# down (the poll loop just logs and retries), this only orders a clean boot.
After=network-online.target traccar.service
Wants=network-online.target

# If it crash-loops, stop trying rather than hammering Traccar forever.
# (These are [Unit] options in systemd >= 229; they are ignored in [Service].)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/carva/automation

# Secrets live here, NOT in the repo and NOT on the command line (where they
# would show up in `ps`). Create it with mode 0600, root-owned:
#   CARVA_TRACCAR_EMAIL=...
#   CARVA_TRACCAR_PASSWORD=...
# The leading "-" means a missing file is not a startup failure, so the service
# can also run purely from config.json.
EnvironmentFile=-/etc/carva/automation.env

# --- EMERGENCY BRAKE -------------------------------------------------------
# Uncomment the next line (or set it in the EnvironmentFile) to force every
# action to dry-run without editing config.json, then: systemctl restart carva-automation
# Environment=CARVA_AUTOMATION_DISABLE=1
# ---------------------------------------------------------------------------

ExecStart=/usr/bin/node /opt/carva/automation/runner.js /opt/carva/automation/config.json

Restart=always
RestartSec=10

# Unbuffered, line-oriented logs straight into the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carva-automation

# State and audit log live here; systemd creates it as /var/lib/carva.
StateDirectory=carva
StateDirectoryMode=0750

# --- Hardening -------------------------------------------------------------
# User=root is required only so the unit can be dropped in without extra setup;
# the process itself needs nothing beyond outbound HTTP to localhost:8082 and
# write access to /var/lib/carva. These limit the blast radius.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# NOT MemoryDenyWriteExecute=yes — V8's JIT must map writable-then-executable
# memory, so that hardening makes node abort at startup with a fatal
# "Check failed: 12 == errno" during baseline compilation.
MemoryDenyWriteExecute=no
# ProtectSystem=strict makes everything read-only except these:
ReadWritePaths=/var/lib/carva

[Install]
WantedBy=multi-user.target
