[Unit]
Description=Carva Fleet alert mailer (emails geofence rules, alarms, power cut, offline, overspeed, speed cameras, bumps)
Documentation=file:/opt/carva/automation/mailer.js
After=network-online.target traccar.service carva-automation.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/carva/automation

# Traccar login (shared with the automation runner) and SMTP settings.
# Both root-only (0600). The SMTP password itself is read by curl from
# /etc/carva/mail.netrc, never passed on the command line.
EnvironmentFile=/etc/carva/automation.env
EnvironmentFile=/etc/carva/mail.env

# Log the emails instead of sending them:
# Environment=CARVA_MAILER_DRYRUN=1

ExecStart=/usr/bin/node /opt/carva/automation/mailer.js

Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=carva-mailer

StateDirectory=carva
StateDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# V8's JIT needs writable+executable memory (see carva-automation.service).
MemoryDenyWriteExecute=no
ReadWritePaths=/var/lib/carva

[Install]
WantedBy=multi-user.target
